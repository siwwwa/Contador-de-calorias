          \{/* Header */\}\
          <header className="bg-[#155D27] text-[#FDFBF7] p-4 shadow-md sticky top-0 z-10">\
            <div className="flex justify-between items-center mb-2">\
              <h1 className="text-xl font-bold flex items-center gap-2">\
                <span className="bg-[#A9C3B4] text-[#155D27] p-1 rounded-md text-sm">NT</span>\
                NutriTrack\
              </h1>\
              <div className="text-sm opacity-80 flex items-center gap-1">\
                <i className="fa-solid fa-user text-sm"></i> Hola, \{perfil.nom || 'Usuari'\}\
              </div>\
            </div>\
          </header>\
\
          \{/* Main Content Area */\}\
          <main className="flex-1 overflow-y-auto">\
            \
            \{/* VISTA INICI / CERCA */\}\
            \{view === 'home' && (\
              <div className="p-4 space-y-4">\
                <div className="relative">\
                  <i className="fa-solid fa-magnifying-glass absolute left-3 top-4 text-[#155D27] opacity-60 text-lg"></i>\
                  <input \
                    type="text" \
                    placeholder="Busca un ingredient..." \
                    value=\{cerca\}\
                    onChange=\{(e) => setCerca(e.target.value)\}\
                    className="w-full p-3 pl-10 rounded-xl border border-[#A9C3B4] bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-[#155D27]"\
                  />\
                </div>\
\
                <div className="space-y-3 mt-4">\
                  \{cerca.trim() === '' ? (\
                    <div className="text-center text-[#155D27] text-opacity-70 mt-16 p-6 bg-white rounded-xl border border-dashed border-[#A9C3B4]">\
                      <i className="fa-solid fa-database mx-auto mb-3 opacity-60 text-3xl block"></i>\
                      <p className="font-semibold text-lg mb-1">Base de dades connectada</p>\
                      <p className="text-sm">Escriu el nom de l'ingredient a dalt per iniciar la cerca (ex: Poma, Llet, Galetes...)</p>\
                    </div>\
                  ) : (\
                    <>\
                      <h2 className="font-semibold text-lg border-b-2 border-[#A9C3B4] pb-1">Resultats de cerca</h2>\
                      \{alimentsFiltrats.map(aliment => \{\
                        const alertes = obtenirAlertes(aliment, aliment.porcioBase || 100);\
                        const teAlertes = alertes.length > 0;\
                        \
                        return (\
                          <div \
                            key=\{aliment.id\} \
                            onClick=\{() => \{ \
                              setAlimentSeleccionat(aliment); \
                              setQuantitat(aliment.porcioBase || 100);\
                              setView('detail'); \
                            \}\}\
                            className=\{`p-4 rounded-xl shadow-sm cursor-pointer transition-transform hover:scale-[1.02] flex justify-between items-center\
                              $\{teAlertes ? 'bg-red-50 border-l-4 border-red-500' : 'bg-white border border-[#A9C3B4] border-opacity-40'\}\
                            `\}\
                          >\
                            <div>\
                              <h3 className=\{`font-bold text-lg $\{teAlertes ? 'text-red-700' : 'text-[#155D27]'\}`\}>\{aliment.nom\}</h3>\
                              <p className="text-sm text-gray-500">\{aliment.calories\} kcal</p>\
                            </div>\
                            \{teAlertes && (\
                              <div className="flex flex-col items-end gap-1">\
                                \{alertes.map(alerta => (\
                                  <div key=\{alerta.id\} className="flex items-center text-red-600 text-[10px] sm:text-xs font-semibold bg-red-100 px-2 py-1 rounded-md">\
                                    <i className="fa-solid fa-triangle-exclamation mr-1 text-xs"></i> \{alerta.titol\}\
                                  </div>\
                                ))\}\
                              </div>\
                            )\}\
                          </div>\
                        )\
                      \})\}\
                      \{alimentsFiltrats.length === 0 && (\
                        <p className="text-center text-gray-500 mt-10">Cap ingredient coincideix amb la teva recerca a la base de dades.</p>\
                      )\}\
                    </>\
                  )\}\
                </div>\
              </div>\
            )\}\
\
            \{/* VISTA DETALL ALIMENT */\}\
            \{view === 'detail' && alimentSeleccionat && (\
              <div className="p-4 pb-24 animate-in fade-in zoom-in-95 duration-200">\
                <button onClick=\{() => setView('home')\} className="flex items-center text-[#155D27] mb-4 font-semibold">\
                  <i className="fa-solid fa-chevron-left text-xl mr-2"></i> Tornar a la cerca\
                </button>\
                \
                \{(() => \{\
                  const factor = quantitat / (alimentSeleccionat.porcioBase || 100);\
                  const alertesActuals = obtenirAlertes(alimentSeleccionat, quantitat);\
                  \
                  return (\
                    <React.Fragment>\
                      \{/* Llistat din\'e0mic d'alertes */\}\
                      \{alertesActuals.length > 0 && (\
                        <div className="space-y-2 mb-4">\
                          \{alertesActuals.map(alerta => (\
                            <div key=\{alerta.id\} className="bg-red-100 text-red-800 p-3 rounded-xl flex gap-3 shadow-sm border border-red-300 items-center">\
                              <i className="fa-solid fa-triangle-exclamation flex-shrink-0 text-red-600 text-2xl"></i>\
                              <div>\
                                <p className="font-bold text-sm">\{alerta.titol\}</p>\
                                <p className="text-xs">\{alerta.text\}</p>\
                              </div>\
                            </div>\
                          ))\}\
                        </div>\
                      )\}\
\
                      <div className=\{`bg-white rounded-2xl p-6 shadow-md border-t-8 $\{alertesActuals.length > 0 ? 'border-red-500' : 'border-[#A9C3B4]'\}`\}>\
                        <div className="flex justify-between items-end border-b border-gray-100 pb-4 mb-4">\
                          <h2 className=\{`text-3xl font-extrabold $\{alertesActuals.length > 0 ? 'text-red-700' : 'text-[#155D27]'\}`\}>\
                            \{alimentSeleccionat.nom\}\
                          </h2>\
                          <span className="text-xl font-bold bg-[#A9C3B4] bg-opacity-30 text-[#155D27] px-3 py-1 rounded-lg">\
                            \{Math.round(alimentSeleccionat.calories * factor)\} kcal\
                          </span>\
                        </div>\
\
                        \{/* Selector de Quantitat */\}\
                        <div className="mb-6 bg-[#FDFBF7] p-4 rounded-xl border border-[#A9C3B4] border-opacity-50">\
                          <label className="block text-sm font-bold text-[#155D27] mb-2">Quantitat (\{alimentSeleccionat.unitat || 'g'\}):</label>\
                          <div className="flex items-center gap-2">\
                            <input \
                              type="number" \
                              min="0"\
                              value=\{quantitat\}\
                              onChange=\{(e) => setQuantitat(Number(e.target.value))\}\
                              className="w-full p-3 rounded-lg border border-[#A9C3B4] focus:outline-none focus:ring-2 focus:ring-[#155D27] text-lg font-bold"\
                            />\
                            <span className="text-gray-500 font-semibold">\{alimentSeleccionat.unitat || 'g'\}</span>\
                          </div>\
                        </div>\
\
                        \{/* Macronutrients */\}\
                        <div className="mb-6">\
                          <h3 className="font-bold text-lg mb-3 flex items-center gap-2">\
                            <i className="fa-solid fa-circle-info text-lg"></i> Macronutrients\
                          </h3>\
                          \{(() => \{\
                            const macrosCalculats = \{\
                              carbohidrats: alimentSeleccionat.macros.carbohidrats * factor,\
                              proteina: alimentSeleccionat.macros.proteina * factor,\
                              greixos: alimentSeleccionat.macros.greixos * factor\
                            \};\
                            const percent = calcularPercentatgesMacros(macrosCalculats);\
                            \
                            return (\
                              <div className="space-y-3">\
                                <div className="flex justify-between items-center text-sm">\
                                  <span className="font-semibold w-24">Carbohidrats</span>\
                                  <div className="flex-1 mx-3 h-3 bg-gray-200 rounded-full overflow-hidden">\
                                    <div className="bg-orange-500 h-full" style=\{\{ width: `$\{percent.carbohidrats\}%` \}\}></div>\
                                  </div>\
                                  <span className="w-12 text-right">\{percent.carbohidrats\}%</span>\
                                  <span className="w-12 text-right text-gray-500">\{Math.round(macrosCalculats.carbohidrats * 10) / 10\}g</span>\
                                </div>\
                                <div className="flex justify-between items-center text-sm">\
                                  <span className="font-semibold w-24">Prote\'efnes</span>\
                                  <div className="flex-1 mx-3 h-3 bg-gray-200 rounded-full overflow-hidden">\
                                    <div className="bg-[#155D27] h-full" style=\{\{ width: `$\{percent.proteina\}%` \}\}></div>\
                                  </div>\
                                  <span className="w-12 text-right">\{percent.proteina\}%</span>\
                                  <span className="w-12 text-right text-gray-500">\{Math.round(macrosCalculats.proteina * 10) / 10\}g</span>\
                                </div>\
                                <div className="flex justify-between items-center text-sm">\
                                  <span className="font-semibold w-24">Greixos</span>\
                                  <div className="flex-1 mx-3 h-3 bg-gray-200 rounded-full overflow-hidden">\
                                    <div className="bg-yellow-500 h-full" style=\{\{ width: `$\{percent.greixos\}%` \}\}></div>\
                                  </div>\
                                  <span className="w-12 text-right">\{percent.greixos\}%</span>\
                                  <span className="w-12 text-right text-gray-500">\{Math.round(macrosCalculats.greixos * 10) / 10\}g</span>\
                                </div>\
                              </div>\
                            );\
                          \})()\}\
                        </div>\
\
                        \{/* Micronutrients */\}\
                        <div>\
                          <h3 className="font-bold text-lg mb-3 pt-4 border-t border-gray-100 text-[#155D27]">\
                            Micronutrients\
                          </h3>\
                          <div className="grid grid-cols-2 gap-x-4 gap-y-2 text-xs bg-[#FDFBF7] p-3 rounded-xl border border-[#A9C3B4] border-opacity-30">\
                            \{LLISTA_MICROS.map(micro => \{\
                              const valorCalculat = (alimentSeleccionat.micros[micro.key] || 0) * factor;\
                              return (\
                                <div key=\{micro.key\} className="flex justify-between items-center border-b border-gray-100 py-1 last:border-0">\
                                  <span className="text-gray-700 truncate pr-2">\{micro.nom\}</span>\
                                  <span className="font-semibold text-[#155D27]">\
                                    \{Math.round(valorCalculat * 100) / 100\} \{micro.unitat\}\
                                  </span>\
                                </div>\
                              );\
                            \})\}\
                          </div>\
                        </div>\
\
                        <button \
                          onClick=\{() => afegirAlCarreto(alimentSeleccionat)\}\
                          className="w-full mt-6 bg-[#155D27] text-[#FDFBF7] p-4 rounded-xl font-bold flex items-center justify-center gap-2 shadow-lg hover:bg-[#10481E] active:scale-95 transition-all"\
                        >\
                          <i className="fa-solid fa-plus text-xl"></i> Afegir al carret\'f3\
                        </button>\
                      </div>\
                    </React.Fragment>\
                  );\
                \})()\}\
              </div>\
            )\}\
\
            \{/* VISTA CARRET\'d3 (Resum del dia) */\}\
            \{view === 'cart' && (\
              <div className="p-4 space-y-4 pb-24">\
                <h2 className="text-2xl font-extrabold text-[#155D27] border-b-2 border-[#A9C3B4] pb-2">El teu carret\'f3 d'avui</h2>\
                \
                \{carreto.length === 0 ? (\
                  <div className="text-center p-10 bg-white rounded-2xl shadow-sm border border-gray-200">\
                    <i className="fa-solid fa-cart-shopping mx-auto text-gray-300 mb-3 text-5xl block"></i>\
                    <p className="text-gray-500">Encara no has afegit cap aliment.</p>\
                    <button onClick=\{() => setView('home')\} className="mt-4 text-[#155D27] font-bold underline">\
                      Buscar aliments\
                    </button>\
                  </div>\
                ) : (\
                  <>\
                    <div className="bg-white rounded-2xl shadow-sm border border-[#A9C3B4] border-opacity-50 overflow-hidden">\
                      <div className="p-3 bg-[#A9C3B4] bg-opacity-20 font-bold text-[#155D27] flex justify-between">\
                        <span>Ingredients (\{carreto.length\})</span>\
                        <span>\{totalsCarreto.calories\} kcal</span>\
                      </div>\
                      <div className="divide-y divide-gray-100">\
                        \{carreto.map((item, index) => \{\
                          const factor = item.quantitat / (item.aliment.porcioBase || 100);\
                          const cals = Math.round(item.aliment.calories * factor);\
                          return (\
                            <div key=\{index\} className="p-3 flex justify-between items-center">\
                              <div>\
                                <p className="font-semibold text-sm">\{item.aliment.nom\} <span className="text-[#A9C3B4] ml-1 font-normal">(\{item.quantitat\}\{item.aliment.unitat || 'g'\})</span></p>\
                                <p className="text-xs text-gray-500">\{cals\} kcal</p>\
                              </div>\
                              <button \
                                onClick=\{() => eliminarDelCarreto(index)\}\
                                className="text-red-400 hover:text-red-600 p-2"\
                              >\
                                <i className="fa-solid fa-trash-can text-base"></i>\
                              </button>\
                            </div>\
                          );\
                        \})\}\
                      </div>\
                    </div>\
\
                    <div className="bg-white rounded-2xl p-4 shadow-sm border border-[#A9C3B4] border-opacity-50 mt-4">\
                      <h3 className="font-bold text-[#155D27] mb-3">Total Macronutrients</h3>\
                      \{(() => \{\
                        const percent = calcularPercentatgesMacros(totalsCarreto.macros);\
                        return (\
                          <div className="space-y-3">\
                            <div className="flex justify-between items-center text-sm">\
                              <span className="font-semibold w-24">Carbohidrats</span>\
                              <span className="font-bold text-orange-500">\{percent.carbohidrats\}%</span>\
                              <span className="w-16 text-right text-gray-500">\{Math.round(totalsCarreto.macros.carbohidrats)\}g</span>\
                            </div>\
                            <div className="flex justify-between items-center text-sm">\
                              <span className="font-semibold w-24">Prote\'efnes</span>\
                              <span className="font-bold text-[#155D27]">\{percent.proteina\}%</span>\
                              <span className="w-16 text-right text-gray-500">\{Math.round(totalsCarreto.macros.proteina)\}g</span>\
                            </div>\
                            <div className="flex justify-between items-center text-sm">\
                              <span className="font-semibold w-24">Greixos</span>\
                              <span className="font-bold text-yellow-600">\{percent.greixos\}%</span>\
                              <span className="w-16 text-right text-gray-500">\{Math.round(totalsCarreto.macros.greixos)\}g</span>\
                            </div>\
                          </div>\
                        );\
                      \})()\}\
                    </div>\
\
                    <div className="bg-white rounded-2xl p-4 shadow-sm border border-[#A9C3B4] border-opacity-50 mt-4">\
                      <h3 className="font-bold text-[#155D27] mb-3">Total Micronutrients</h3>\
                      \
                      \{perfil.hipertensio && totalsCarreto.micros.sodi > 2000 && (\
                        <div className="bg-red-100 text-red-800 p-3 rounded-lg text-xs flex gap-2 mb-3 border border-red-200 items-center">\
                          <i className="fa-solid fa-triangle-exclamation text-red-600 flex-shrink-0 text-base"></i>\
                          <span>Has superat el l\'edmit diari recomanat de sodi (2000mg) per a la hipertensi\'f3. Total: \{Math.round(totalsCarreto.micros.sodi)\}mg.</span>\
                        </div>\
                      )\}\
\
                      <div className="grid grid-cols-2 gap-x-4 gap-y-2 text-[11px]">\
                        \{LLISTA_MICROS.map(micro => \{\
                          const quantitat = totalsCarreto.micros[micro.key];\
                          const isSodi = micro.key === 'sodi';\
                          const alertaActiva = isSodi && perfil.hipertensio && quantitat > 2000;\
                          \
                          return (\
                            <div key=\{micro.key\} className=\{`flex justify-between border-b border-gray-100 py-1 $\{alertaActiva ? 'text-red-600 font-bold' : 'text-gray-600'\}`\}>\
                              <span className="truncate pr-1">\{micro.nom\}</span>\
                              <span>\{Math.round(quantitat * 10) / 10\} \{micro.unitat\}</span>\
                            </div>\
                          );\
                        \})\}\
                      </div>\
                    </div>\
                  </>\
                )\}\
              </div>\
            )\}\
          </main>\
\
          \{/* Bottom Navigation */\}\
          <nav className="absolute bottom-0 w-full bg-[#155D27] flex justify-around p-3 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] rounded-t-xl text-[#FDFBF7]">\
            <button \
              onClick=\{() => \{ setView('home'); setAlimentSeleccionat(null); \}\}\
              className=\{`flex flex-col items-center p-2 px-6 rounded-xl transition-colors $\{view === 'home' || view === 'detail' ? 'bg-[#A9C3B4] text-[#155D27]' : 'hover:bg-[#10481E]'\}`\}\
            >\
              <i className="fa-solid fa-magnifying-glass text-2xl"></i>\
              <span className="text-xs font-semibold mt-1">Cerca</span>\
            </button>\
            <button \
              onClick=\{() => setView('cart')\}\
              className=\{`flex flex-col items-center p-2 px-6 rounded-xl transition-colors relative $\{view === 'cart' ? 'bg-[#A9C3B4] text-[#155D27]' : 'hover:bg-[#10481E]'\}`\}\
            >\
              <i className="fa-solid fa-cart-shopping text-2xl"></i>\
              <span className="text-xs font-semibold mt-1">Diari</span>\
              \{carreto.length > 0 && (\
                <span className="absolute top-1 right-4 bg-red-500 text-white text-[10px] w-5 h-5 flex items-center justify-center rounded-full border-2 border-[#155D27]">\
                  \{carreto.length\}\
                </span>\
              )\}\
            </button>\
          </nav>\
        </div>\
      );\
    \}\
\
    const root = ReactDOM.createRoot(document.getElementById('root'));\
    root.render(<App />);\
  </script>\
</body>\
</html>}